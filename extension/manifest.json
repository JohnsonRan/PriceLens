{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "0.4.2",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "contextMenus", "scripting"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "optional_host_permissions": ["https://api.typesafe.ai/*", "https://api.wise.com/*"],
  "homepage_url": "https://github.com/JohnsonRan/PriceLens",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["shared.js", "dom.js", "evidence.js", "placement.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
